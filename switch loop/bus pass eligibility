#include<stdio.h>
int main()
{
    int category,distance;
    scanf("%d %d",&category,&distance);
    switch(category){
        case 1:
        if(distance <= 30)
        {
            printf("Eligible");
        }
        else{
            printf("Eligible with extra fee");
        }
        break;
        case 2:
        if(distance <= 30)
        {
            printf("Eligible");
        }
        else{
            printf("Not Eligible");
        }
        break;
        case 3:
        printf("Eligible");
        default:
        printf("Invalid category");
    }
    return 0;
}
