#include<stdio.h>
int main()
{
    int connectiontype,units,bill = 0;
    scanf("%d %d",&connectiontype,&units);
    switch(connectiontype)
    {
        case 1:
        if(units <= 30){
        bill = units * 5;
        }
        else{
            bill = (30 * 5) + ((units - 30) * 8);
            }
            break;
            case 2:
            bill = units * 10;
            break;
            default:
            printf("Invalid connectiontype");
    }
        printf("₹ %d",bill);
        return 0;
}
