#include<stdio.h>
int main()
{
    int role,time;
    scanf("%d %d",&role,&time);
    switch(role)
    {
        case 1:
        printf("Full Access anytime");
        break;
        case 2:
        if(time >= 9 && time <= 20){
            printf("Limited access");
        }
        else{
            printf("Access denied");
        }
        break;
        default:
        printf("Invalid Role");
    }
    return 0;
}
