#include<stdio.h>
int main()
{
    int booktype,dayslate,fee = 0;
    scanf("%d %d",&booktype,&dayslate);
    switch(booktype)
    {
        case 1:
        fee = dayslate * 2;
        break;
        case 2:
        fee = dayslate * 5;
        break;
        default:
        printf("Invalid book type");
    }
    printf("₹ %d",fee);
    return 0;
}
