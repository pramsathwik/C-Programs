#include<stdio.h>
int main()
{
    int vehicletype,distance,fare = 0;
    scanf("%d %d",&vehicletype,&distance);
    switch(vehicletype)
    {
        case 1:
        fare = distance * 10;
        break;
        case 2:
        fare = distance * 15;
        break;
        case 3:
        fare = distance * 20;
        break;
        default:
        printf("Invalid vehicletype");
    }
    printf("₹ %d",fare);
    return 0;
}
