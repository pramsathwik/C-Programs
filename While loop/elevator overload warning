#include <stdio.h>
int main() {
    int maxWeight, N;
    scanf("%d",&maxWeight);
    scanf("%d",&N);
    int weight[N];
    int i = 0;
    while(i < N) {
        scanf("%d", &weight[i]);
        i++;
    }
    int total = 0,allowed = 0,overload = 0;
    i = 0;
    while(i < N) {
        total += weight[i];
        if(total > maxWeight) {
            overload = 1;
            break;
        }
        allowed++;
        i++;
    }
    printf("Passengers Allowed: %d\n", allowed);
    if(overload == 1) {
        printf("Overload: Yes");
    } else {
        printf("Overload: No");
    }
    return 0;
}
