#include<stdio.h>
int main()
{
    int classtype,fee = 0;
    scanf("%d",&classtype);
    switch(classtype)
    {
        case 1:     //sleeper
        fee = 300;
        break;
        case 2:     //3AC
        fee = 800;
        break;
        case 3:     //2AC
        fee = 1500;
        break;
        default:
        printf("Invalid class type");
    }
    printf("₹ %d",fee);
    return 0;
}
