#include<stdio.h>
int main()
{
    int deliverymode,deliverycharge;
    scanf("%d",&deliverymode);
    switch(deliverymode)
    {
        case 1:
        deliverycharge = 40;
        break;
        case 2:
        deliverycharge = 120;
        break;
        case 3:
        printf("Free");
        break;
        default:
        printf("Invalid Deliverymode");
    }
    printf("₹ %d",deliverycharge);
    return 0;
}
