bool checkIfPangram(char* sentence) {
    int alpha[26]={0};
    int index=0;for(int i=0;sentence[i];i++){
        if(sentence[i]>='a'&&sentence[i]<='z'){
            index=sentence[i]-'a';
            alpha[index]=1;
        }
        if(sentence[i]>='A'&&sentence[i]<='Z'){
            index=sentence[i]-'A';
            alpha[index]=1;
        }
    }
    for(int i=0;i<26;i++){
        if(alpha[i]==0){
            return false;
        }
    }
    return true;
}
